{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Il nome del Worker resta quello d'origine anche dopo il cambio nome
  // dell'app: e' lui a generare l'indirizzo soundanalyst.<account>.workers.dev.
  // Cambiarlo non rinomina niente — crea un Worker nuovo a un altro
  // indirizzo, lascia acceso il vecchio e invalida i redirect di Supabase
  // e la PWA gia' installata. Si cambia insieme al dominio proprio.
  "name": "soundanalyst",
  "compatibility_date": "2026-11-05",
  "main": "worker/index.js",

  // Il dominio proprio. Dichiararlo qui invece di attaccarlo a mano dal
  // pannello vuol dire che il deploy lo rimette da solo: se un giorno il
  // Worker viene ricreato, l'indirizzo torna su senza che qualcuno si
  // ricordi di ripassare dal pannello.
  //
  // custom_domain crea anche il record DNS. Perche' funzioni la zona
  // campobase.dev deve stare in questo stesso account Cloudflare — e ci sta,
  // perche' il dominio e' registrato qui.
  //
  // www c'e' perche' qualcuno lo scrivera' comunque. Punta allo stesso
  // Worker: nessun reindirizzamento da mantenere.
  "routes": [
    { "pattern": "campobase.dev",     "custom_domain": true },
    { "pattern": "www.campobase.dev", "custom_domain": true }
  ],

  "assets": {
    // La radice del repo: l'app e' un singolo index.html piu' icone.
    // Cosa NON viene caricato sta in .assetsignore.
    "directory": ".",

    // I percorsi che non corrispondono a un file ricadono su index.html.
    // E' cosi' che si configura un'applicazione a pagina singola su Workers:
    // _redirects qui non va usato, perche' un rewrite verso /index.html
    // viene rifiutato in fase di deploy come loop infinito.
    "not_found_handling": "single-page-application",

    // Il Worker gira solo per queste rotte. Senza questa riga /api/* non lo
    // raggiungerebbe mai: non esiste un file con quel nome, quindi la
    // richiesta ricadrebbe su index.html e il client riceverebbe HTML al
    // posto del JSON.
    "run_worker_first": ["/api/*"]
  },

  // Ogni minuto, per le notifiche a orario. "Fra 10 minuti" con cinque
  // minuti di scarto diventa "fra 10 o fra 15", e per un pick-up alle
  // sette e mezza la differenza si sente.
  "triggers": {
    "crons": ["* * * * *"]
  },

  // Qui NON va dichiarato un blocco "vars". Le variabili scritte a mano
  // nel pannello e non ripetute in questo file vengono rimosse al deploy,
  // e fra quelle ci sono SUPABASE_URL e SUPABASE_SERVICE_KEY: un deploy
  // avrebbe spento la posta. La chiave pubblica VAPID sta scritta nel
  // codice, in worker/push.js, dove la vede anche l'app: e' pubblica per
  // definizione, e tenerla in un posto solo evita che le due parti
  // finiscano per usarne due diverse.

  "observability": {
    "enabled": true
  }
}
